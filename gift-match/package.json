{
  "name": "gift-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run build && npm test && npm run e2e",
    "preview:single": "vite build --mode single && node scripts/single-file.mjs",
    "catalog:import": "vite-node scripts/catalog-cli.ts import --",
    "catalog:audit": "vite-node scripts/catalog-cli.ts audit --"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
